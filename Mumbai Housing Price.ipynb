    "def price_final(price, price_unit):\n",
    "    if price_unit == 'L':\n",
    "        return price / 100  # since 1 Cr = 100 L\n",
    "    elif price_unit == 'Cr':\n",
    "        return price        # already in Cr\n",
    "    else:\n",
    "        return price / 1e7 "
   ]
